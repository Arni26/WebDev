{
	"info": {
		"name": "Lab10 Shop API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Get All Categories",
			"request": {
				"method": "GET",
				"url": "http://127.0.0.1:8001/api/categories/"
			}
		},
		{
			"name": "Create Category",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Electronics\"\n}"
				},
				"url": "http://127.0.0.1:8001/api/categories/"
			}
		},
		{
			"name": "Get Category by ID",
			"request": {
				"method": "GET",
				"url": "http://127.0.0.1:8001/api/categories/1/"
			}
		},
		{
			"name": "Update Category",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"Gadgets\"\n}"
				},
				"url": "http://127.0.0.1:8001/api/categories/1/"
			}
		},
		{
			"name": "Delete Category",
			"request": {
				"method": "DELETE",
				"url": "http://127.0.0.1:8001/api/categories/1/"
			}
		},
		{
			"name": "Get Category Products",
			"request": {
				"method": "GET",
				"url": "http://127.0.0.1:8001/api/categories/1/products/"
			}
		},
		{
			"name": "Get All Products",
			"request": {
				"method": "GET",
				"url": "http://127.0.0.1:8001/api/products/"
			}
		},
		{
			"name": "Create Product",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"iPhone 15\",\n    \"price\": 999.99,\n    \"description\": \"Latest iPhone model\",\n    \"count\": 50,\n    \"is_active\": true,\n    \"category\": 1\n}"
				},
				"url": "http://127.0.0.1:8001/api/products/"
			}
		},
		{
			"name": "Get Product by ID",
			"request": {
				"method": "GET",
				"url": "http://127.0.0.1:8001/api/products/1/"
			}
		},
		{
			"name": "Update Product",
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"name\": \"iPhone 15 Pro\",\n    \"price\": 1199.99,\n    \"description\": \"Latest iPhone Pro model\",\n    \"count\": 30,\n    \"is_active\": true,\n    \"category\": 1\n}"
				},
				"url": "http://127.0.0.1:8001/api/products/1/"
			}
		},
		{
			"name": "Delete Product",
			"request": {
				"method": "DELETE",
				"url": "http://127.0.0.1:8001/api/products/1/"
			}
		}
	]
}
